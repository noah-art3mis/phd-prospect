{
  "_comment": "Golden contract for the deterministic validate() seam (src/core/validate.cjs). Each case's `expect` is either the string \"ok\" (candidate is persistence-safe) or {\"invalid\": \"<exact InvalidRecord message>\"}. Add a case here for every new validation rule. Two contract changes landed with the standalone-app rebuild (see issue #22): the deadline is the SOLE critical finding, so funding, eligibility and required_documents no longer need evidence to be `found`; and the SSRF helpers are gone, because nothing fetches a user-submitted URL locally (ADR-0007) – a source_url only has to be http or https.",
  "cases": [
    {
      "name": "happy_path",
      "expect": "ok",
      "input": {
        "title": "PhD in Trustworthy Artificial Intelligence",
        "source_url": "https://university.example/research/phd/trustworthy-ai",
        "findings": {
          "institution": {
            "state": "found",
            "value": [
              "Example University"
            ],
            "evidence": [
              {
                "url": "https://university.example/research/phd/trustworthy-ai",
                "retrieved_at": "2026-07-06T10:00:00+00:00",
                "excerpt": "Example University invites applications for a PhD in Trustworthy AI."
              }
            ]
          },
          "deadline": {
            "state": "found",
            "value": [
              "2026-12-01T23:59:00+01:00"
            ],
            "evidence": [
              {
                "url": "https://university.example/research/phd/trustworthy-ai#apply",
                "retrieved_at": "2026-07-06T10:00:00+00:00",
                "excerpt": "Applications close at 23:59 CET on 1 December 2026."
              }
            ]
          },
          "eligibility": {
            "state": "needs_confirmation",
            "value": [],
            "evidence": []
          },
          "required_documents": {
            "state": "not_stated",
            "value": [],
            "evidence": []
          }
        }
      }
    },
