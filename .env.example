# Prospect configuration. Copy to .env and fill in.
#
# Every key below is required — the app refuses to start with any of them missing or
# malformed, naming the offending key. The model id and max_tokens are deliberately absent:
# they live in the prompt file (prompts/ingest.prompt), because they are tuned together with
# the wording rather than varying by deployment.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id. Exactly one user is admitted; everyone else is ignored.
TELEGRAM_ALLOWED_USER_ID=

# From console.anthropic.com.
ANTHROPIC_API_KEY=

# IANA timezone. Deadlines with no stated zone are read in this one, and reminders fire on
# its clock — so relocating moves when reminders arrive rather than shifting stored dates.
TZ=

# Days before a deadline to be reminded, comma-separated. 0 means "closes today".
REMINDER_LEAD_TIMES=

# Hour of the local day the reminder sweep runs, 0-23.
REMINDER_SEND_HOUR=

# GCS bucket for the daily off-box backup. Written through the instance's attached service
# account, so there is no credential file and nothing to expire.
GCS_BACKUP_BUCKET=

# Where the SQLite file lives. On the VM this is inside the bind-mounted host directory, so
# the database survives the container.
DB_PATH=
